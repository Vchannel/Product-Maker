# --- WordPress / WooCommerce site ---
WP_SITE_URL=https://vchannelstore.com

# WooCommerce REST API keys (WooCommerce > Settings > Advanced > REST API)
# Quyền cần thiết: Read/Write
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WordPress Application Password - KHÁC với WC key ở trên, dùng riêng để upload
# ảnh qua wp/v2/media (WC key không có quyền gọi API lõi của WordPress).
# Tạo tại: wp-admin > Users > Profile (hồ sơ của bạn) > Application Passwords
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Tuỳ chọn (có thể override bằng --discount / --status khi chạy) ---
PRICE_DISCOUNT_VND=45000
WC_PRODUCT_STATUS=draft
